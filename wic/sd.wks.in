# short-description: Create SD card image for Hailo
# long-description: Creates a partitioned SD card image for Hailo.
# Boot files are located in the first vfat partition.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --fixed-size="${SD_FIXED_SIZE}M" --use-uuid

# --no-fstab-update va sulla partizione di root: significa "non riscrivere il fstab qui".
# La riga di /boot la mette base-files, per etichetta, perche' il rootfs dello .swu non
# passa da wic. Senza questa opzione la wic ne avrebbe due per lo stesso mountpoint.
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --align 4 --use-uuid --no-fstab-update
